{
  "name": "personal-training-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-python-runtime.mjs",
    "prebuild": "node scripts/copy-python-runtime.mjs",
    "prebuild:pages": "node scripts/copy-python-runtime.mjs",
    "generate:practice": "python scripts/generate-practice.py",
    "generate:acm": "python scripts/generate-acm.py",
    "verify:practice": "python scripts/verify-practice.py",
    "test:practice": "python scripts/test-practice-harness.py && python scripts/test-acm-harness.py && python scripts/verify-practice.py && python scripts/verify-acm.py && node scripts/verify-practice-wasm.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "generate:algorithms": "node scripts/generateAlgorithmData.mjs",
    "enrich:llm": "node scripts/llmEnrichReview.mjs",
    "sync:xunji": "node --env-file-if-exists=.env.local scripts/sync-xunji.mjs",
    "update:stock": "node scripts/fetchHithinkData.mjs && node scripts/generateStockData.mjs",
    "validate:lessons": "node scripts/validateLessons.mjs",
    "deploy:branch": "node scripts/push-gh-pages.mjs",
    "test": "vitest run",
    "build:pages": "vite build --base=/blog/ && node scripts/patch-gh-pages.mjs /blog/"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.24.0",
    "mermaid": "^12.2.0",
    "pyodide": "0.27.7",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
