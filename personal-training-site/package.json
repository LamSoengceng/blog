{
  "name": "personal-training-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "generate:algorithms": "node scripts/generateAlgorithmData.mjs",
    "enrich:llm": "node scripts/llmEnrichReview.mjs",
    "sync:xunji": "node --env-file-if-exists=.env.local scripts/sync-xunji.mjs",
    "test": "vitest run",
    "build:pages": "vite build --base=/blog/ && node scripts/patch-gh-pages.mjs /blog/"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
